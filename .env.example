# Copy to .env.local and fill in. Never commit real values.
# Full setup notes: docs/build-plan.md, section 6.

# --- App ---
# used in alert links + Twilio webhook URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... (safe in the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... SERVER ONLY, bypasses RLS. Get with `supabase projects api-keys --reveal`
SUPABASE_SECRET_KEY=
# for `supabase gen types` / migrations
SUPABASE_PROJECT_REF=
# CLI migrations only, not needed on Vercel
SUPABASE_DB_PASSWORD=
# DEV ONLY, local only: session-pooler URL for `npm run test:db`
SUPABASE_DEV_DB_URL=

# --- Twilio ---
TWILIO_ACCOUNT_SID=
# also verifies X-Twilio-Signature on webhooks
TWILIO_AUTH_TOKEN=
# preferred for REST calls (rotatable)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# default Messaging Service (per-business SIDs live in DB)
TWILIO_MESSAGING_SERVICE_SID=

# --- Anthropic ---
ANTHROPIC_API_KEY=
# live SMS turns
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# summaries, extraction
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5

# --- Email (Resend, used by Supabase for login/invite emails) ---
# re_... Only needed in your shell when running `supabase config push`
RESEND_API_KEY=

# --- Admin ---
# comma-separated; who can open /admin (e.g. you@example.com)
PLATFORM_ADMIN_EMAILS=

# --- Ops ---
# Vercel Cron auth header for /api/cron/*
CRON_SECRET=
# optional
SENTRY_DSN=
# your cell, for system failures
INTERNAL_ALERT_PHONE=
