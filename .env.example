# Copy to .env.local and fill in. Never commit real values.
# Full setup notes: docs/build-plan.md, section 6.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used in alert links + Twilio webhook URLs

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=       # sb_publishable_... (safe in the browser)
SUPABASE_SECRET_KEY=                        # sb_secret_... SERVER ONLY, bypasses RLS. Get with `supabase projects api-keys --reveal`
SUPABASE_PROJECT_REF=                       # for `supabase gen types` / migrations
SUPABASE_DB_PASSWORD=                       # CLI migrations only, not needed on Vercel
SUPABASE_DEV_DB_URL=                        # DEV ONLY, local only: session-pooler URL for `npm run test:db`

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                          # also verifies X-Twilio-Signature on webhooks
TWILIO_API_KEY_SID=                         # preferred for REST calls (rotatable)
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=               # default Messaging Service (per-business SIDs live in DB)

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5       # live SMS turns
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5     # summaries, extraction

# --- Email (Resend, used by Supabase for login/invite emails) ---
RESEND_API_KEY=                             # re_... Only needed in your shell when running `supabase config push`

# --- Admin ---
PLATFORM_ADMIN_EMAILS=                      # comma-separated; who can open /admin (e.g. you@example.com)

# --- Ops ---
CRON_SECRET=                                # Vercel Cron auth header for /api/cron/*
SENTRY_DSN=                                 # optional
INTERNAL_ALERT_PHONE=                       # your cell, for system failures
